CONFIG_IDF_TARGET="esp32s3"

# ESP32-S3-DevKitC-1-N8R8: 8 MB flash, 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The SparkFun u-blox library times its waits in ticks and recommends 1 kHz.
CONFIG_FREERTOS_HZ=1000

# Logs and the target lines both go out the USB port the board is flashed
# through; UART0 stays free.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# esp32_BNO08x: give up waiting for a report after 100 ms rather than 3 s, so
# the IMU task notices a silent hub within ping::kImuSilenceMs. Pins and the
# SPI clock are passed in code from ping/constants.hpp, not set here.
CONFIG_ESP32_BNO08X_DATA_AVAILABLE_TIMEOUT_MS=100
